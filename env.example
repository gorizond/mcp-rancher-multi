# Rancher Multi-Server Configuration via Environment Variables
# Copy this file to .env and fill in your values
# 
# This project supports loading configuration from .env files:
# - .env.local (highest priority, for local development)
# - .env (default configuration)
#
# You can also use environment variables directly without .env files.

# Method 1: JSON configuration in single environment variable
# RANCHER_SERVERS='{"prod":{"id":"prod","name":"Rancher PROD","baseUrl":"https://rancher.prod.example.com","token":"${ENV:RANCHER_TOKEN_prod}","insecureSkipTlsVerify":false},"lab":{"id":"lab","name":"Rancher LAB","baseUrl":"https://rancher.lab.example.com","token":"${ENV:RANCHER_TOKEN_lab}"}}'

# Method 2: Individual environment variables for each server
# Format: RANCHER_SERVER_<ID>_<PROPERTY>

# Production server
RANCHER_SERVER_prod_NAME=Rancher PROD
RANCHER_SERVER_prod_BASEURL=https://rancher.prod.example.com
RANCHER_SERVER_prod_TOKEN=${ENV:RANCHER_TOKEN_prod}
RANCHER_SERVER_prod_INSECURESKIPTLSVERIFY=false

# Lab server
RANCHER_SERVER_lab_NAME=Rancher LAB
RANCHER_SERVER_lab_BASEURL=https://rancher.lab.example.com
RANCHER_SERVER_lab_TOKEN=${ENV:RANCHER_TOKEN_lab}

# Token values (replace with actual tokens)
RANCHER_TOKEN_prod=your_production_token_here
RANCHER_TOKEN_lab=your_lab_token_here

# Optional: Custom CA certificate (base64 encoded)
# RANCHER_SERVER_prod_CACERTPEMBASE64=LS0tLS1CRUdJTi...

# ---- Optional feature flags (default: false; restart required) ----
# Node shell: run one command on a node via the Rancher server (node-driver machines only).
# ENABLE_NODE_SHELL=true

# Pod exec: run one command in a pod via the Rancher Kubernetes proxy.
# ENABLE_CONTAINER_EXEC=true

# Note: k8s_raw safety is per-call, not env-based:
#   - mutating methods are blocked unless the call passes allowWrite: true
#   - Secret data/stringData is masked unless the call passes showSensitiveData: true
